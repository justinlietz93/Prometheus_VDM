{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "meters-ebn.schema.json",
  "title": "Metriplectic KG meters EBN skeleton spec (v1)",
  "type": "object",
  "metadata": { "tag": "meters-ebn.v1" },
  "required": [
    "run_name",
    "version",
    "tag",
    "schema_ref",
    "parameters",
    "seeds",
    "meters"
  ],
  "properties": {
    "run_name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "tag": {
      "type": "string",
      "const": "meters-ebn.v1"
    },
    "schema_ref": {
      "type": "string"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "seeds": {
      "type": "array",
      "items": { "type": "integer" },
      "minItems": 1
    },
    "meters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "parameters", "seeds"],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "kg_cone",
              "kg_dispersion",
              "kg_energy_osc",
              "identity"
            ]
          },
          "parameters": {
            "type": "object",
            "additionalProperties": true
          },
          "seeds": {
            "type": "array",
            "items": { "type": "integer" },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}