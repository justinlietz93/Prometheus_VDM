{
  "run_name": "Topo-RDM",
  "version": "1.0.0",
  "tag": "dsi-topo-rdm-v1",
  "schema_ref": "Derivation/code/physics/black_holes/topo_rdm/schemas/topo_rdm.schema.json",
  "data": {
    "timeseries_csv": "",
    "ridges_csv": ""
  },
  "parameters": {
    "omega0_ref": "qnm220",
    "window": [0.0, 8.0],
    "whitener": "median-psd",
    "taper": "planck",
    "K_QNM": 3,

    "stft": {
      "nperseg": 256,
      "noverlap": 128,
      "freq_max": 2048.0,
      "top_k": 3,
      "power_quantile": 0.95
    },

    "ridge": {
      "k_neighbors": 2,
      "max_gap": 2,
      "phase_coherence_min": 0.6
    },

    "filtration": {
      "kind": "vrips",
      "radius_min": 0.01,
      "radius_max": 0.5,
      "num_scales": 64
    },

    "nulls": {
      "kerr_only": true,
      "phase_shuffled": true,
      "num_sim": 200,
      "kerr_only_ridges": []
    },

    "b1z": {
      "fdr_q": 0.01,
      "z_gate_primary": 5.0,
      "z_gate_null": 3.0
    },

    "alignment": {
      "eps_target": 0.12,
      "tol_pct": 5.0
    }
  },
  "seeds": [1, 2, 3]
}