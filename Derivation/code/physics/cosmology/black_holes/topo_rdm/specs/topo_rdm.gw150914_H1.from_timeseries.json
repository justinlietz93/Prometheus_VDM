{
  "run_name": "Topo-RDM",
  "version": "1.0.0",
  "tag": "dsi-topo-rdm-v1",
  "schema_ref": "Derivation/code/physics/cosmology/black_holes/topo_rdm/schemas/topo_rdm.schema.json",
  "data": {
    "timeseries_csv": "Derivation/code/physics/cosmology/black_holes/topo_rdm/testdata/gw150914_H1.csv"
  },
  "parameters": {
    "omega0_ref": "qnm220",
    "window": [0.0, 8.0],
    "whitener": "median-psd",
    "taper": "planck",
    "K_QNM": 3,

    "ridge": {
      "k_neighbors": 2,
      "max_gap": 2,
      "phase_coherence_min": 0.6
    },

    "stft": {
      "nperseg": 512,
      "noverlap": 384,
      "freq_max": 1024.0,
      "power_quantile": 0.98,
      "top_k": 5
    },

    "filtration": {
      "kind": "vrips",
      "radius_min": 0.01,
      "radius_max": 0.5,
      "num_scales": 64,
      "use_quantile_bounds": true,
      "qmin": 0.10,
      "qmax": 0.75,
      "connectivity_cap": true,
      "cap_pct": 0.90
    },

    "nulls": {
      "kerr_only": false,
      "phase_shuffled": true,
      "num_sim": 200,
      "kerr_only_ridges": []
    },

    "b1z": {
      "fdr_q": 0.01,
      "z_gate_primary": 5.0,
      "z_gate_null": 3.0
    },

    "alignment": {
      "require_dsi_alignment": true
    }
  },
  "seeds": [1]
}